# Contact form (netlify/functions/contact.mts). Set these in Netlify:
# Site configuration > Environment variables. For `netlify dev`, copy this file to .env.
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate for several addresses)
CONTACT_TO_EMAIL=hello@strikebits.com
# Sender on a domain verified in Resend
CONTACT_FROM_EMAIL=StrikeBits Website <website@strikebits.com>
